# ── Supabase (already in your Vercel project) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── NEW: needed for XP, leaderboard and push (server only, never expose) ──
# Supabase dashboard → Project Settings → API → "service_role" key
SUPABASE_SERVICE_ROLE_KEY=

# ── NEW: push notifications ────────────────────────────────────────────
# Create the pair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any long random string. Vercel Cron sends it so only Vercel can trigger /api/push/send
CRON_SECRET=
